{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k-arv.com/schemas/material-metadata.schema.json",
  "title": "KARV Fabric Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "supplier",
    "brand",
    "collection",
    "reference",
    "color",
    "category",
    "fabric_type",
    "composition_percent",
    "width_m",
    "weight_per_linear_meter_g",
    "origin",
    "technologies",
    "appearance",
    "performance",
    "applications",
    "care",
    "commercial_intelligence",
    "physical_reference_cm",
    "assets",
    "sources",
    "research"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "supplier": { "type": "string", "minLength": 1 },
    "brand": { "type": ["string", "null"] },
    "collection": { "type": "string", "minLength": 1 },
    "reference": { "type": "string", "minLength": 1 },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "family"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 }
      }
    },
    "category": { "type": "string", "minLength": 1 },
    "fabric_type": { "type": "string", "minLength": 1 },
    "composition_percent": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
    },
    "width_m": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "weight_per_linear_meter_g": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "origin": { "type": ["string", "null"] },
    "technologies": { "$ref": "#/$defs/stringArray" },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["texture", "touch", "sheen", "visual_character"],
      "properties": {
        "texture": { "type": ["string", "null"] },
        "touch": { "type": ["string", "null"] },
        "sheen": { "type": ["string", "null"] },
        "visual_character": { "$ref": "#/$defs/stringArray" }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durability", "water_repellency", "pet_friendly", "easy_clean", "indoor_use", "outdoor_use"],
      "properties": {
        "durability": { "type": ["string", "null"] },
        "water_repellency": { "type": ["boolean", "null"] },
        "pet_friendly": { "type": ["boolean", "null"] },
        "easy_clean": { "type": ["boolean", "null"] },
        "indoor_use": { "type": ["boolean", "null"] },
        "outdoor_use": { "type": ["boolean", "null"] }
      }
    },
    "applications": { "$ref": "#/$defs/stringArray" },
    "care": { "$ref": "#/$defs/stringArray" },
    "commercial_intelligence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_for", "advantages", "restrictions", "suggested_styles", "suggested_combinations"],
      "properties": {
        "recommended_for": { "$ref": "#/$defs/stringArray" },
        "advantages": { "$ref": "#/$defs/stringArray" },
        "restrictions": { "$ref": "#/$defs/stringArray" },
        "suggested_styles": { "$ref": "#/$defs/stringArray" },
        "suggested_combinations": { "$ref": "#/$defs/stringArray" }
      }
    },
    "physical_reference_cm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "const": 120 },
        "height": { "type": "number", "const": 60 }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_color", "normal", "ao", "preview", "storage_status"],
      "properties": {
        "base_color": { "type": ["string", "null"] },
        "normal": { "type": ["string", "null"] },
        "ao": { "type": ["string", "null"] },
        "preview": { "type": ["string", "null"] },
        "storage_status": { "enum": ["google_drive_only", "github_ready", "published"] }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "url", "verified_on"],
        "properties": {
          "type": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "verified_on": { "type": "string", "format": "date" },
          "scope": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence", "notes"],
      "properties": {
        "status": { "enum": ["verified", "partially_verified", "pending", "not_found"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
